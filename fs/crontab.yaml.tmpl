
jobs:
  - name: BackupJob
    concurrency: 1
    tasks:
      - command: {{ .Env.BACKUP_COMMAND }}
        retries: {{ .Env.BACKUP_RETRY }}
        timeout: {{ .Env.BACKUP_TIMEOUT }}
        working-dir: {{ .Env.BACKUP_DIRECTORY }}
        env:
          SHELL: /bin/bash
        on-done:
          - command: echo "Done"
{{- if coll.Has .Env "ON_DONE" }}
          - command: {{ .Env.ON_DONE }}
            working-dir: {{ .Env.BACKUP_DIRECTORY }}
{{- end }}
{{- if coll.Has .Env "UPLOAD_COMMAND" }}
          - command: {{ .Env.UPLOAD_COMMAND }}
            working-dir: {{ .Env.BACKUP_DIRECTORY }}
{{- end }}
        on-fail:
          - command: echo "Failed"
{{ if coll.Has .Env "ON_FAIL" }}
          - command: {{ .Env.ON_FAIL }}
            working-dir: {{ .Env.BACKUP_DIRECTORY }}
{{- end }}
    events:
      - cron: "{{ .Env.BACKUP_CRON }}"
      - on-init: {{ (.Env.BACKUP_ON_INIT | strings.ToLower | regexp.Match `^(1|y|yes|t|true)$`) }}
